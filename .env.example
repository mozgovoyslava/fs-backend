# Runtime
NODE_ENV=development
APP_PORT=4000
ALLOWED_ORIGIN=http://localhost:3000

# GraphQL
GRAPHQL_PREFIX=/graphql

# PostgreSQL
# Parts for POSTGRES_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SCHEMA=public

# The app and Prisma currently read this full URL.
# Requires dotenv variable expansion.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}

# Redis
# Parts for REDIS_URL.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# The app currently reads this full URL.
# Requires dotenv variable expansion.
# Format: redis://:<password>@<host>:<port>/<database>
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Cookies
COOKIES_SECRET=change-me-cookies-secret

# Session
SESSION_SECRET=change-me-session-secret
SESSION_NAME=sid
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=30d
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER=sess:

# Mailer
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_LOGIN=mailer@example.com
MAILER_PASSWORD=change-me-mailer-password
MAILER_FROM=noreply@example.com
